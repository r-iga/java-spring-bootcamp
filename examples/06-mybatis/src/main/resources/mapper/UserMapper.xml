<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="bootcamp.mybatis.mapper.UserMapper">

    <!--
        resultMap: DBのカラム名(created_at) と Javaフィールド名(createdAt) のマッピング
        map-underscore-to-camel-case=true を設定済みなので自動変換されるが、
        明示的に書くこともできる
    -->
    <resultMap id="userResultMap" type="bootcamp.mybatis.entity.User">
        <id     property="id"        column="id"/>
        <result property="name"      column="name"/>
        <result property="email"     column="email"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 1件取得 -->
    <select id="findById" resultMap="userResultMap">
        SELECT id, name, email, created_at
        FROM users
        WHERE id = #{id}
    </select>

    <!-- 全件取得 -->
    <select id="findAll" resultMap="userResultMap">
        SELECT id, name, email, created_at
        FROM users
        ORDER BY id
    </select>

    <!-- メールアドレスで検索 -->
    <select id="findByEmail" resultMap="userResultMap">
        SELECT id, name, email, created_at
        FROM users
        WHERE email = #{email}
    </select>

    <!-- メールアドレスの存在確認 -->
    <select id="existsByEmail" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM users
        WHERE email = #{email}
    </select>

    <!-- 挿入（自動採番IDをエンティティに設定） -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (name, email)
        VALUES (#{name}, #{email})
    </insert>

    <!-- 更新 -->
    <update id="update">
        UPDATE users
        SET name  = #{name},
            email = #{email}
        WHERE id = #{id}
    </update>

    <!-- 削除 -->
    <delete id="deleteById">
        DELETE FROM users WHERE id = #{id}
    </delete>

</mapper>
